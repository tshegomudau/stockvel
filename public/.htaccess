<IfModule mod_rewrite.c>
    RewriteEngine On

    # Relative front-controller rewrite (works for DocumentRoot = public/
    # and subdirectory installs like /projects/stovel/public/). Do not set
    # RewriteBase / — that rewrites to the server DocumentRoot.

    # Pass Authorization header to PHP (Apache CGI/FastCGI).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve existing files and directories directly (CSS, JS, images, uploads).
    # Application CSV download routes are not real files — force them through PHP.
    RewriteCond %{REQUEST_URI} \.csv$ [NC]
    RewriteRule ^ index.php [L,QSA]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Front controller for application routes.
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
