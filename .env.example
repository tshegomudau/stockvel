# Copy to .env then: php bin/console setup
# For tests, also copy to .env.testing with DB_DATABASE=stockvel_testing

APP_NAME=stockvel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
# Leave empty for web-root installs. Set when hosted in a subdirectory, e.g. /projects/stockvel-fund/public
APP_BASE_PATH=
# Bump to force clients to reload CSS/JS. In local env, filemtime() is also used.
ASSET_VERSION=1
APP_KEY=change-me-to-a-random-64-char-string-please-rotate

# Database (create empty DB first: CREATE DATABASE stockvel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stockvel
DB_USERNAME=stockvel
DB_PASSWORD=stockvel_pass
DB_CHARSET=utf8mb4

# Session / cookies
SESSION_NAME=stockvel_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

# Security
PASSWORD_ALGO=argon2id
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CSRF_TOKEN_TTL=7200
RATE_LIMIT_WINDOW=60
REMEMBER_ME_DAYS=30
FORCE_PASSWORD_CHANGE_OUTSIDE_DEV=true

# Defaults (South Africa)
APP_TIMEZONE=Africa/Johannesburg
APP_CURRENCY=ZAR
APP_LOCALE=en_ZA

# Mail
# Drivers: log (dev → storage/mail), smtp (generic PHPMailer), smtp2go (PHPMailer + SMTP2GO defaults)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@your-verified-domain.co.za
MAIL_FROM_NAME=stockvel
MAIL_REPLY_TO=
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=30
# If primary MAIL_PORT cannot connect (common on shared hosting), try these next.
# Defaults for MAIL_DRIVER=smtp2go when left empty in code: 587,465,8025,80
MAIL_PORT_FALLBACKS=587,465,8025,80
# Only if the host CA bundle breaks TLS (prefer fixing CA instead)
MAIL_SMTP_OPTIONS_INSECURE=false
# Optional aliases when MAIL_DRIVER=smtp2go
SMTP2GO_USERNAME=
SMTP2GO_API_KEY=

# Support / ops alerts (also configurable under Platform → Settings)
# Used when php bin/console test:all reports failures (unless disabled in platform settings).
SUPPORT_EMAIL=support@your-domain.co.za
TEST_FAILURE_EMAIL_ENABLED=true

# SMS (log = development logger)
SMS_DRIVER=log
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=

# WhatsApp placeholder
WHATSAPP_DRIVER=log
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# Payments (mock works without credentials)
PAYMENT_DRIVER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_MERCHANT_ID=

# Uploads / storage
UPLOAD_MAX_MB=10
DOCUMENT_RETENTION_DAYS=2555
# Prefer Platform → Features & storage in the UI; env is a fallback when DB settings are empty.
STORAGE_DRIVER=local
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# Cron
CRON_LOCK_TTL=300
# Shared hosting: public/cron.php?token=… (leave empty to disable web cron)
CRON_TOKEN=
# Shared hosting installer: public/install.php?token=… (or use storage/install.token from pack script)
INSTALL_TOKEN=

# Testing — use a dedicated database name containing "test" / "testing"
# Example: copy to .env.testing and run: php bin/console db:reset --env=testing
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DATABASE=stockvel_testing
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_PREFIX=
