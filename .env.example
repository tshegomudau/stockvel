# Copy to .env then: php bin/console setup
# For tests, also copy to .env.testing with DB_DATABASE=stockvel_testing

APP_NAME=stockvel
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090
# Leave empty for web-root installs. Set when hosted in a subdirectory, e.g. /projects/stockvel-fund/public
APP_BASE_PATH=
# Bump to force clients to reload CSS/JS. In local env, filemtime() is also used.
ASSET_VERSION=1
APP_KEY=change-me-to-a-random-64-char-string-please-rotate

# Database (create empty DB first: CREATE DATABASE stockvel CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stockvel
DB_USERNAME=stockvel
DB_PASSWORD=stockvel_pass
DB_CHARSET=utf8mb4

# Session / cookies
SESSION_NAME=stockvel_session
SESSION_LIFETIME=120
SESSION_SECURE=false
SESSION_SAME_SITE=Lax

# Security
PASSWORD_ALGO=argon2id
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CSRF_TOKEN_TTL=7200
RATE_LIMIT_WINDOW=60
REMEMBER_ME_DAYS=30
FORCE_PASSWORD_CHANGE_OUTSIDE_DEV=true

# Defaults (South Africa)
APP_TIMEZONE=Africa/Johannesburg
APP_CURRENCY=ZAR
APP_LOCALE=en_ZA

# Mail (log = write to storage/mail; smtp = real SMTP)
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=noreply@stockvel.local
MAIL_FROM_NAME=stockvel
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# SMS (log = development logger)
SMS_DRIVER=log
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER=

# WhatsApp placeholder
WHATSAPP_DRIVER=log
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# Payments (mock works without credentials)
PAYMENT_DRIVER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-change-me
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_MERCHANT_ID=

# Uploads / storage
UPLOAD_MAX_MB=10
DOCUMENT_RETENTION_DAYS=2555

# Cron
CRON_LOCK_TTL=300

# Testing — use a dedicated database name containing "test" / "testing"
# Example: copy to .env.testing and run: php bin/console db:reset --env=testing
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DATABASE=stockvel_testing
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_PREFIX=
